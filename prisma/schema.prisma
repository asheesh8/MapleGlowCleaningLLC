generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id        String   @id @default(cuid())
  reference String   @unique

  name  String
  email String
  phone String

  address String
  city    String
  zip     String

  serviceType String
  frequency   String
  bedrooms    Int    @default(1)
  bathrooms   Int    @default(1)
  sqft        Int?
  addOns      String @default("")

  preferredDate String?
  preferredTime String?

  notes String?

  estimateLow  Int
  estimateHigh Int

  status String @default("new")

  photos BookingPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model BookingPhoto {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  filename String
  mimeType String
  size     Int
  caption  String?

  createdAt DateTime @default(now())

  @@index([bookingId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model CleaningService {
  id          String  @id
  name        String
  short       String
  description String
  includes    String  @default("[]")
  base        Int
  icon        String  @default("sparkles")
  order       Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model CleaningAddOn {
  id     String  @id
  name   String
  price  Int
  order  Int     @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model ChatConversation {
  id          String  @id @default(cuid())
  visitorName String?
  email       String?
  phone       String?
  status      String  @default("new")

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([updatedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role String
  body String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model Testimonial {
  id       String  @id @default(cuid())
  author   String
  body     String
  source   String  @default("facebook")
  featured Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
}
